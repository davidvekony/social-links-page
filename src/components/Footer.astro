---
import { Rocket } from "lucide-react";
import { CodeXml } from "lucide-react";
---

<footer class="flex flex-col items-center max-w-[90vw] mx-auto my-4 mt-12">
  <h5 class="text-sm font-heading">Built with Astro</h5>
  <div class="flex items-center gap-4">
    <a
      href="https://astro.build/"
      target="_blank"
      rel="noopener"
      class="text-foreground hover:opacity-70 transition-opacity"
      aria-label="Astro"
    >
      <Rocket size={20} />
    </a>
    <a
      href="https://github.com/davidvekony/social-links-page"
      target="_blank"
      rel="noopener"
      class="text-foreground hover:opacity-70 transition-opacity"
      aria-label="GitHub"
    >
      <CodeXml size={20} />
    </a>
  </div>
</footer>
