---
import { Image } from "astro:assets";
import AstroLogo from "../images/logomark-dark.png";
import GitHubLogo from "../images/github-mark.png";
---

<footer class="flex flex-col items-center max-w-[90vw] mx-auto my-4 mt-12">
  <h5 class="text-sm font-heading">Built with Astro</h5>
  <div class="flex items-center">
    <a href="https://astro.build/" target="_blank" rel="noopener">
      <Image
        src={AstroLogo}
        width={25}
        class="mx-2"
        alt="Astro Logo"
      />
    </a>
    <a
      href="https://github.com/davidvekony/social-links-page"
      target="_blank"
      rel="noopener"
    >
      <Image
        src={GitHubLogo}
        width={25}
        class="mx-2"
        alt="GitHub Logo"
      />
    </a>
  </div>
</footer>
