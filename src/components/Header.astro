---
import { Image } from "astro:assets";

type Props = {
  name: string;
  avatar: {
    src: ImageMetadata;
    alt: string;
  };
};

const { name, avatar } = Astro.props;
---

<div class="flex flex-col items-center">
  <Image
    src={avatar.src}
    width={125}
    alt={avatar.alt}
    class="rounded-full mt-4 outline-2 outline-border"
  />
  <h1 class="text-5xl my-8">{name}</h1>
</div>
