---
import { buttonVariants } from "./ui/button";
import { cn } from "@/lib/utils";

const { imageClass, url, label, colour } = Astro.props;

type Link = {
  label: string;
  url: string;
  imageClass: string;
  colour?: string;
};

const buttonClass = cn(
  buttonVariants({ variant: "neutral", size: "lg" }),
  "w-full text-base",
  label === "Buy Me A Coffee" ? "!bg-[#ffdd00] font-bold" : "",
);
---

<div class="link-row flex items-center gap-4">
  <i
    class={`fa-xl ${imageClass}`}
    style={`--fa-animation-duration: 3s; --fa-animation-iteration-count: 1; ${colour ? `--fa-color: ${colour};` : ""}`}
  ></i>
  <a href={url} target="_blank" rel="noopener" class={buttonClass}>
    {label}
  </a>
</div>

<script>
  const linkRows = document.querySelectorAll("div.link-row");

  linkRows.forEach((linkRow) => {
    const icon = linkRow.querySelector("i");

    if (icon) {
      linkRow.addEventListener("mouseover", () => {
        icon.classList.add("fa-shake");
      });

      linkRow.addEventListener("mouseout", () => {
        icon.classList.remove("fa-shake");
      });
    }
  });
</script>
